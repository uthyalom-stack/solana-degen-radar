# Worker secrets are configured with `wrangler secret put`; never commit real values.
SOCIAL_INGEST_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHANNELS=
HELIUS_API_KEY=
PUMPPORTAL_API_KEY=\nX_BEARER_TOKEN=\n\n# Optional X recent-search configuration (newline-separated queries; comma-separated usernames)\nX_SEARCH_QUERIES=\nX_TRACKED_ACCOUNTS=

# Worker vars
DASHBOARD_ORIGIN=http://localhost:3000
SOCIAL_RSS_FEEDS=
DEXSCREENER_BASE_URL=https://api.dexscreener.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PAPER_STARTING_BALANCE=5

# Dashboard build-time variable; this is public by design.
NEXT_PUBLIC_RADAR_API_URL=http://127.0.0.1:8787

# Optional: comma-separated verified Jito tip destination accounts (weak bundle indicator only)
JITO_TIP_ACCOUNTS=
# Optional: comma-separated Wormhole/deBridge Solana program IDs for bridge interaction monitoring
BRIDGE_PROGRAM_IDS=
# Optional: comma-separated verified Solana launchpad/AMM program IDs for raw program activity monitoring
SOLANA_DISCOVERY_PROGRAM_IDS=
